[mysqld]
# 基础配置
server-id=2
log-bin=mysql-bin
binlog-format=ROW
binlog-expire-logs-seconds=604800

# 启用 LOAD DATA LOCAL INFILE（批量导入数据）
local_infile=1

# 字符集
# ★ 全库统一 utf8mb4 + utf8mb4_general_ci（项目全局规则.md §十六 铁律八）
character-set-server=utf8mb4
collation-server=utf8mb4_general_ci
# ★ init_connect 必须显式带 COLLATE（勿简写成 'SET NAMES utf8mb4'）：
#   只写 SET NAMES utf8mb4 会把 collation_connection 设成 **utf8mb4 字符集自身的默认
#   排序规则 utf8mb4_0900_ai_ci**（不是 collation_server），进而污染新建视图的
#   字面量派生列（CASE ... THEN '启用'），造成跨表比较 ERROR 1267。
init_connect='SET NAMES utf8mb4 COLLATE utf8mb4_general_ci'

# 性能配置（开发环境适中）
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT

# 连接配置
max_connections=500
wait_timeout=28800
interactive_timeout=28800

# 慢查询日志
slow_query_log=1
slow_query_log_file=/var/lib/mysql/slow.log
long_query_time=2

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
# ★ 兜底（勿删）：`default-character-set=utf8mb4` 只设字符集，collation_connection 会落到
#   utf8mb4 的**默认排序规则 utf8mb4_0900_ai_ci**。这里用 init-command 显式纠正为 general_ci，
#   使手工执行 SQL（尤其含视图的迁移脚本）默认就在统一排序规则下。
#   ⚠️ 只能放在 [mysql] —— 放进 [client] 会让 mysqldump / mysqladmin 因未知变量而报错。
init-command="SET NAMES utf8mb4 COLLATE utf8mb4_general_ci"
