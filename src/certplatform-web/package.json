{
  "name": "certplatform-web",
  "private": true,
  "version": "1.0.0",
  "description": "认证平台前端工作区",
  "workspaces": [
    "admin",
    "auditor",
    "share",
    "yzh.vue.core"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=admin",
    "dev:auditor": "npm run dev --workspace=auditor",
    "build:core": "npm run build --workspace=yzh.vue.core",
    "build:share": "npm run build --workspace=share",
    "build:admin": "npm run build --workspace=admin",
    "build:auditor": "npm run build --workspace=auditor",
    "build:all": "npm run build:core && npm run build:share && npm run build:admin && npm run build:auditor",
    "typecheck:all": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
