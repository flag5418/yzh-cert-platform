<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>YZH.Core.DataBase</RootNamespace>
    <AssemblyName>YZH.Core.DataBase</AssemblyName>
    <Description>YZH Core DataBase - 数据访问层：EF Core封装、通用仓储</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- SqlSugar ORM（唯一 ORM，支持多数据库 MySQL/Oracle/SQLServer/PostgreSQL/SQLite/达梦/人大金仓） -->
    <PackageReference Include="SqlSugarCore" Version="5.1.4.167" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YZH.Core.Stand\YZH.Core.Stand.csproj" />
  </ItemGroup>

</Project>
