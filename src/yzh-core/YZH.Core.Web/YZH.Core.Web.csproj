<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>YZH.Core.Web</RootNamespace>
    <AssemblyName>YZH.Core.Web</AssemblyName>
    <Description>YZH Core Web - 唯一启动入口：Program.cs、YzhWebBuilder、中间件、模块注册</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⛔ 不引用 src/old/**（Vol 旧框架）。原 YZH.Core / YZH.Entity / YZH.Sys 三条引用已于 2026-09-24 移除：
         · YZH.Entity / YZH.Sys —— 新架构已由 CertPlatform.Shared/Compat/YzhCompatShims.cs 自建同命名空间垫片，冗余
         · YZH.Core（Aliases="VolFramework"）—— 唯一用途是登录验证码，已迁移至自建实现（见 AuthController.GetCaptcha） -->
    <!-- YZH Core框架（无前缀，直接使用） -->
    <ProjectReference Include="..\YZH.Core.Api\YZH.Core.Api.csproj" />
    <ProjectReference Include="..\YZH.Core.DataBase\YZH.Core.DataBase.csproj" />
    <ProjectReference Include="..\YZH.Core.Stand\YZH.Core.Stand.csproj" />
    <!-- 业务模块。CertPlatform.Shared 挂 extern alias：其类型不暴露到全局命名空间（本层只用 AddApplicationPart 按程序集名加载，不直接 typeof），
         与 Program.cs:149 的说明保持一致。 -->
    <ProjectReference Include="..\..\certplatform-api\CertPlatform.Shared\CertPlatform.Shared.csproj" Aliases="CertPlatform,SharedEntities" />
    <ProjectReference Include="..\..\certplatform-api\CertPlatform.Admin\CertPlatform.Admin.csproj" />
    <ProjectReference Include="..\..\certplatform-api\CertPlatform.Auditor\CertPlatform.Auditor.csproj" />
    <!-- ⛔ CertPlatform.Enterprise = **未开工的空壳项目**（Controllers/Services/Entities 三目录全空，
         全项目仅 .csproj + .DS_Store）。本引用只为让 sln 保持三端形状。
         ⚠️ 往该端加代码时必须同步三处，否则【运行时静默失效、零启动错误】：
           ① Program.cs: AddCertPlatformEnterpriseServices()
           ② Program.cs: AddApplicationPart(typeof(CertPlatform.Enterprise.Controllers.XxxController).Assembly)
           ③ Program.cs: BusinessEntityConfigPaths 加 Enterprise/Assets/EntityConfigs
         漏 ①② ⇒ 接口 404；漏 ③ ⇒ EntityConfig 静默空（标题=类型名、页面有数据行但一列都不显示）。
         详情：docs/10-YZH架构/24-后端实体归属清单-V1.md §五 A3 -->
    <ProjectReference Include="..\..\certplatform-api\CertPlatform.Enterprise\CertPlatform.Enterprise.csproj" />
  </ItemGroup>

  <!-- 配置文件复制到输出目录 -->
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 核心模块配置（User、Role、Menu、SysConfig 等） -->
    <Content Update="Assets\System\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="GridConfigs\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
