<Project Sdk="Microsoft.NET.Sdk">

  <!--
    定向验证工程：仅引用被测框架 YZH.Core。
    测试框架 / 版本 / 编译选项统一由 YZH-Framework/Directory.Build.props 注入，
    此处不再重复声明 PackageReference（避免 NU1504 重复引用警告）。
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 本验证工程使用可空注解（覆盖 Directory.Build.props 的 Nullable=disable）-->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YZH.Core\YZH.Core.csproj" />
  </ItemGroup>

</Project>
