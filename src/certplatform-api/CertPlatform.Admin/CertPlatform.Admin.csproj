<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CertPlatform.Admin</RootNamespace>
    <AssemblyName>CertPlatform.Admin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.0.0" />
    <!-- ★ 2026-10-02 提示词工作台：企业文档 Markdown 复用缓存（仅此用途；不改框架层 INoSql） -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CertPlatform.Shared.Entities.Audit" />
    <Using Include="CertPlatform.Shared.Entities.Cert" />
    <Using Include="CertPlatform.Shared.Entities.Dir" />
    <Using Include="CertPlatform.Shared.Entities.Doc" />
    <Using Include="CertPlatform.Shared.Entities.Rpt" />
    <Using Include="CertPlatform.Shared.Entities.Sys" />
    <Using Include="CertPlatform.Shared.Entities.Wf" />
    <!-- ★ 后台端独占实体（2026-10-03 分层修订；清单见 docs/10-YZH架构/24-后端实体归属清单-V1.md） -->
    <Using Include="CertPlatform.Admin.Entities.Cert" />
    <Using Include="CertPlatform.Admin.Entities.Dir" />
        <Using Include="CertPlatform.Admin.Entities.Sys" />
    <Using Include="CertPlatform.Admin.Entities.Wf" />
    <Using Include="CertPlatform.Shared.DocExtraction" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\yzh-core\YZH.Core.Api\YZH.Core.Api.csproj" />
    <ProjectReference Include="..\..\yzh-core\YZH.Core.DataBase\YZH.Core.DataBase.csproj" />
    <ProjectReference Include="..\CertPlatform.Shared\CertPlatform.Shared.csproj" />
  </ItemGroup>

  <!-- 业务 EntityConfig 复制到输出目录 -->
  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
