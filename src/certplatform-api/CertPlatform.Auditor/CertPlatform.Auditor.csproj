<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CertPlatform.Auditor</RootNamespace>
    <AssemblyName>CertPlatform.Auditor</AssemblyName>
    <Description>CertPlatform 认证专家端（专家注册 / 专家登录 / 专家工作区）</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 业务实体全局 using（与 CertPlatform.Admin 保持一致） -->
    <Using Include="CertPlatform.Shared.Entities.Audit" />
    <Using Include="CertPlatform.Shared.Entities.Cert" />
    <Using Include="CertPlatform.Shared.Entities.Dir" />
    <Using Include="CertPlatform.Shared.Entities.Doc" />
    <Using Include="CertPlatform.Shared.Entities.Rpt" />
    <Using Include="CertPlatform.Shared.Entities.Sys" />
    <Using Include="CertPlatform.Shared.Entities.Wf" />
  </ItemGroup>

  <ItemGroup>
    <!-- ★ EntityConfig 必须在构建时复制到输出目录（bin/…/Assets/EntityConfigs/**）：
         基类 EntityConfigHelper 从 **输出目录** 读取，缺这条会「静默空配置」→
         页面有数据行、一列都不显示、控制台零报错。与 CertPlatform.Admin 对齐。 -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 框架层：Sys_User / Sys_Organization / Sys_RoleUser 等实体与 EntityService<> 均在 YZH.Core.Api -->
    <ProjectReference Include="..\..\yzh-core\YZH.Core.Api\YZH.Core.Api.csproj" />
    <ProjectReference Include="..\..\yzh-core\YZH.Core.DataBase\YZH.Core.DataBase.csproj" />
    <ProjectReference Include="..\CertPlatform.Shared\CertPlatform.Shared.csproj" />
  </ItemGroup>

</Project>
